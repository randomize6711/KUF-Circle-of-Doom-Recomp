+void PhysicalHeap::InvalidateNewAllocation(uint32_t physical_address, uint32_t length) {
+  // GPU caches (shared memory, textures) may have marked these pages valid
+  // while they were unallocated - e.g. a fetch from a stale or speculative
+  // address. Write watches can't be installed on inaccessible pages, so
+  // without this the guest's writes to the new allocation would never be
+  // seen and the first upload would be reused forever. Tell the GPU the
+  // contents are new, exactly as a write to a watched page would.
+  auto global_lock = global_critical_region_.Acquire();
+  for (auto invalidation_callback : memory_->physical_memory_invalidation_callbacks_) {
+    invalidation_callback->first(invalidation_callback->second, physical_address, length, true);
+  }
+}
