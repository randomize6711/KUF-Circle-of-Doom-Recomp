+void VulkanSharedMemory::RecordHoistedUploads(VkCommandBuffer command_buffer) {
+  if (!hoisted_copies_.empty()) {
+    const ui::vulkan::VulkanDevice::Functions& dfn = command_processor_.GetVulkanDevice()->functions();
+    // Earlier submissions may still read or write these pages: order the copies after all of their accesses (the
+    // commands of this submission before the original upload points accessed none of the pages).
+    VkPipelineStageFlags access_stage_mask = VK_PIPELINE_STAGE_VERTEX_INPUT_BIT | guest_shader_pipeline_stages_ |
+                                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkBufferMemoryBarrier barrier = {};
+    barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+    barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = buffer_;
+    barrier.offset = 0;
+    barrier.size = VK_WHOLE_SIZE;
+    dfn.vkCmdPipelineBarrier(command_buffer, access_stage_mask, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 1,
+                             &barrier, 0, nullptr);
+    size_t first = 0;
+    upload_regions_.clear();
+    for (size_t i = 0; i <= hoisted_copies_.size(); ++i) {
+      if (i == hoisted_copies_.size() || hoisted_copies_[i].source != hoisted_copies_[first].source) {
+        dfn.vkCmdCopyBuffer(command_buffer, hoisted_copies_[first].source, buffer_, uint32_t(upload_regions_.size()),
+                            upload_regions_.data());
+        upload_regions_.clear();
+        first = i;
+      }
+      if (i < hoisted_copies_.size()) {
+        upload_regions_.push_back(hoisted_copies_[i].region);
+      }
+    }
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_INDEX_READ_BIT | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                            VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT, access_stage_mask, 0, 0, nullptr, 1,
+                             &barrier, 0, nullptr);
+    hoisted_copies_.clear();
+  }
+  for (uint32_t block : submission_touched_blocks_) {
+    submission_touched_pages_[block] = 0;
+  }
+  submission_touched_blocks_.clear();
