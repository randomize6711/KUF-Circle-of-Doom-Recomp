+  // --gpu_timestamp_stats: upload totals every 10 s.
+  if (REXCVAR_GET(gpu_timestamp_stats)) {
+    ++upload_stats_.submissions;
+    const auto now = std::chrono::steady_clock::now();
+    if (upload_stats_start_ == std::chrono::steady_clock::time_point()) {
+      upload_stats_start_ = now;
+    } else if (now - upload_stats_start_ >= std::chrono::seconds(10)) {
+      const UploadStats& u = upload_stats_;
+      const double n = double(u.submissions);
+      REXGPU_INFO(
+          "[gpu-time] shared memory uploads per submission: at submission start {:.1f} ranges ({:.1f} KB), in place "
+          "{:.1f} ({:.1f} KB); {:.1f} MB per second; unchanged pages not uploaded {:.1f} MB per second ({} MB of "
+          "copies)",
+          u.hoisted_ranges / n, u.hoisted_bytes / 1024.0 / n, u.in_place_calls / n, u.in_place_bytes / 1024.0 / n,
+          (u.hoisted_bytes + u.in_place_bytes) / 1048576.0 /
+              std::chrono::duration<double>(now - upload_stats_start_).count(),
+          u.unchanged_bytes / 1048576.0 / std::chrono::duration<double>(now - upload_stats_start_).count(),
+          (uint64_t(upload_copy_count_) << page_size_log2()) >> 20);
+      upload_stats_ = {};
+      upload_stats_start_ = now;
+    }
+  }
