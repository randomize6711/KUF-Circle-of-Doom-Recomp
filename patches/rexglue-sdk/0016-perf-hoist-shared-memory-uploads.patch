+bool VulkanSharedMemory::UploadPages(uint32_t page_start, uint32_t page_count, bool hoisted) {
+  if (!skip_unchanged_uploads_) {
+    return UploadPageRun(page_start, page_count, hoisted);
+  }
+  // KUF port M14: protect the pages first (a CPU write from now on invalidates them again), then upload only the
+  // runs of pages that differ from their copies.
+  const uint32_t page_size = uint32_t(1) << page_size_log2();
+  MakeRangeValid(page_start << page_size_log2(), page_count << page_size_log2(), false);
+  uint32_t run_start = UINT32_MAX;
+  bool successful = true;
+  for (uint32_t page = page_start; page <= page_start + page_count; ++page) {
+    bool unchanged = false;
+    if (page < page_start + page_count) {
+      uint32_t slot = page_upload_copy_[page];
+      unchanged = slot && !std::memcmp(UploadCopy(slot - 1),
+                                       memory().TranslatePhysical(page << page_size_log2()), page_size);
+      if (unchanged) {
+        upload_stats_.unchanged_bytes += page_size;
+      }
+    } else {
+      unchanged = true;  // Closes the last run.
+    }
+    if (!unchanged && run_start == UINT32_MAX) {
+      run_start = page;
+    } else if (unchanged && run_start != UINT32_MAX) {
+      successful &= UploadPageRun(run_start, page - run_start, hoisted);
+      run_start = UINT32_MAX;
+    }
+  }
+  return successful;
+}
+
+void VulkanSharedMemory::DropUploadCopies(uint32_t start, uint32_t length) {
+  if (!upload_copy_count_ || !length || start >= kBufferSize) {
+    return;
+  }
+  uint32_t page_first = start >> page_size_log2();
+  uint32_t page_last = uint32_t(std::min(uint64_t(start) + length, uint64_t(kBufferSize)) - 1) >> page_size_log2();
+  auto drop = [this](uint32_t page) {
+    uint32_t slot = page_upload_copy_[page];
+    if (slot) {
+      page_upload_copy_[page] = 0;
+      upload_copy_page_[slot - 1] = UINT32_MAX;
+      upload_copy_free_.push_back(slot - 1);
+      --upload_copy_count_;
+    }
+  };
+  if (page_last - page_first >= uint32_t(upload_copy_page_.size())) {
+    // A large range (a memory export with an unknown destination): go through the copies instead.
+    for (uint32_t slot = 0; slot < uint32_t(upload_copy_page_.size()); ++slot) {
+      uint32_t page = upload_copy_page_[slot];
+      if (page != UINT32_MAX && page >= page_first && page <= page_last) {
+        drop(page);
+      }
+    }
+    return;
+  }
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    drop(page);
+  }
+}
