+bool VulkanSharedMemory::UploadPageRun(uint32_t page_start, uint32_t page_count, bool hoisted) {
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  uint64_t submission_current = command_processor_.GetCurrentSubmission();
+  while (page_count) {
+    VkBuffer upload_buffer;
+    VkDeviceSize upload_buffer_offset, upload_buffer_size;
+    uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+        submission_current, page_count << page_size_log2(), size_t(1) << page_size_log2(), upload_buffer,
+        upload_buffer_offset, upload_buffer_size);
+    if (upload_buffer_mapping == nullptr) {
+      REXGPU_ERROR("Shared memory: Failed to get a Vulkan upload buffer");
+      return false;
+    }
+    MakeRangeValid(page_start << page_size_log2(), uint32_t(upload_buffer_size), false);
+    if (!skip_unchanged_uploads_) {
+      std::memcpy(upload_buffer_mapping, memory().TranslatePhysical(page_start << page_size_log2()),
+                  upload_buffer_size);
+    } else {
+      // KUF port M14: a page uploaded before gets a copy, and is uploaded from it (the copy is exactly what the GPU
+      // receives).
+      const uint32_t page_size = uint32_t(1) << page_size_log2();
+      uint32_t chunk_pages = uint32_t(upload_buffer_size >> page_size_log2());
+      for (uint32_t i = 0; i < chunk_pages; ++i) {
+        uint32_t page = page_start + i;
+        const uint8_t* source = memory().TranslatePhysical(page << page_size_log2());
+        uint8_t* dest = upload_buffer_mapping + size_t(i) * page_size;
+        uint64_t& uploaded_bits = pages_uploaded_[page >> 6];
+        uint64_t uploaded_bit = uint64_t(1) << (page & 63);
+        uint32_t slot = page_upload_copy_[page];
+        if (!slot && (uploaded_bits & uploaded_bit)) {
+          if (!upload_copy_free_.empty()) {
+            slot = upload_copy_free_.back() + 1;
+            upload_copy_free_.pop_back();
+          } else if (upload_copy_page_.size() < upload_copy_max_) {
+            if (upload_copy_page_.size() % kUploadCopiesPerChunk == 0) {
+              upload_copy_chunks_.emplace_back(new uint8_t[size_t(kUploadCopiesPerChunk) * page_size]);
+            }
+            upload_copy_page_.push_back(UINT32_MAX);
+            slot = uint32_t(upload_copy_page_.size());
+          }
+          if (slot) {
+            page_upload_copy_[page] = slot;
+            upload_copy_page_[slot - 1] = page;
+            ++upload_copy_count_;
+          }
+        }
+        uploaded_bits |= uploaded_bit;
+        if (slot) {
+          uint8_t* copy = UploadCopy(slot - 1);
+          std::memcpy(copy, source, page_size);
+          std::memcpy(dest, copy, page_size);
+        } else {
+          std::memcpy(dest, source, page_size);
+        }
+      }
+    }
+    VkBufferCopy upload_region;
+    upload_region.srcOffset = upload_buffer_offset;
+    upload_region.dstOffset = VkDeviceSize(page_start << page_size_log2());
+    upload_region.size = upload_buffer_size;
+    if (hoisted) {
+      hoisted_copies_.push_back({upload_buffer, upload_region});
+      ++upload_stats_.hoisted_ranges;
+      upload_stats_.hoisted_bytes += upload_buffer_size;
+    } else {
+      if (upload_buffer_previous_ != upload_buffer && !upload_regions_.empty()) {
+        assert_true(upload_buffer_previous_ != VK_NULL_HANDLE);
+        command_buffer.CmdVkCopyBuffer(upload_buffer_previous_, buffer_, uint32_t(upload_regions_.size()),
+                                       upload_regions_.data());
+        upload_regions_.clear();
+      }
+      upload_buffer_previous_ = upload_buffer;
+      upload_regions_.push_back(upload_region);
+      upload_stats_.in_place_bytes += upload_buffer_size;
+    }
+    uint32_t upload_buffer_pages = uint32_t(upload_buffer_size >> page_size_log2());
+    page_start += upload_buffer_pages;
+    page_count -= upload_buffer_pages;
+  }
+  return true;
+}
