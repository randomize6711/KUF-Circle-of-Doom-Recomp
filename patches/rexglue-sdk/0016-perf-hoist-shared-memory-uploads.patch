+void VulkanSharedMemory::TouchPages(uint32_t start, uint32_t length) {
+  if (!hoist_uploads_ || !length || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_first = start >> page_size_log2();
+  uint32_t page_last = (start + length - 1) >> page_size_log2();
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6); ++block) {
+    uint64_t mask = ~uint64_t(0);
+    if (block == (page_first >> 6)) {
+      mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    uint64_t& bits = submission_touched_pages_[block];
+    if (!bits) {
+      submission_touched_blocks_.push_back(block);
+    }
+    bits |= mask;
+  }
+}
+
+bool VulkanSharedMemory::ArePagesTouched(uint32_t page_first, uint32_t page_count) const {
+  uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6); ++block) {
+    uint64_t mask = ~uint64_t(0);
+    if (block == (page_first >> 6)) {
+      mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (submission_touched_pages_[block] & mask) {
+      return true;
+    }
+  }
+  return false;
+}
