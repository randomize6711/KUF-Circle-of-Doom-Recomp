+void VulkanCommandProcessor::InitializeGpuTimestamps() {
+  if (!REXCVAR_GET(gpu_timestamp_stats)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const auto& ifn = vulkan_device->vulkan_instance()->functions();
+  VkPhysicalDeviceProperties properties;
+  ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &properties);
+  uint32_t family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(), &family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> families(family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(), &family_count, families.data());
+  const uint32_t family = vulkan_device->queue_family_graphics_compute();
+  const uint32_t bits = family < family_count ? families[family].timestampValidBits : 0;
+  if (!bits || properties.limits.timestampPeriod <= 0.0f) {
+    REXGPU_WARN("[gpu-time] the graphics queue has no timestamps; --gpu_timestamp_stats unavailable");
+    return;
+  }
+  VkQueryPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  pool_info.queryCount = kGpuTimestampSlots * 2;
+  if (dfn.vkCreateQueryPool(vulkan_device->device(), &pool_info, nullptr, &gpu_timestamp_pool_) != VK_SUCCESS) {
+    REXGPU_WARN("[gpu-time] failed to create the timestamp query pool; --gpu_timestamp_stats unavailable");
+    gpu_timestamp_pool_ = VK_NULL_HANDLE;
+    return;
+  }
+  gpu_timestamp_mask_ = bits >= 64 ? ~uint64_t(0) : (uint64_t(1) << bits) - 1;
+  gpu_timestamp_ns_per_tick_ = properties.limits.timestampPeriod;
+  if (REXCVAR_GET(gpu_timestamp_sections)) {
+    pool_info.queryCount = kGpuSectionSlots * kGpuSectionQueries;
+    if (dfn.vkCreateQueryPool(vulkan_device->device(), &pool_info, nullptr, &gpu_section_pool_) != VK_SUCCESS) {
+      REXGPU_WARN("[gpu-time] failed to create the section query pool; --gpu_timestamp_sections unavailable");
+      gpu_section_pool_ = VK_NULL_HANDLE;
+    }
+  }
+  gpu_timestamp_log_time_ = std::chrono::steady_clock::now();
+  REXGPU_INFO("[gpu-time] timestamps on: {} ns per tick, {} valid bits", gpu_timestamp_ns_per_tick_, bits);
+}
+
+void VulkanCommandProcessor::ShutdownGpuTimestamps() {
+  if (gpu_timestamp_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_timestamp_pool_, nullptr);
+  gpu_timestamp_pool_ = VK_NULL_HANDLE;
+  gpu_timestamp_pending_.clear();
+  if (gpu_section_pool_ != VK_NULL_HANDLE) {
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_section_pool_, nullptr);
+    gpu_section_pool_ = VK_NULL_HANDLE;
+  }
+  gpu_section_pending_.clear();
+  gpu_section_active_ = false;
+}
+
+void VulkanCommandProcessor::CollectGpuTimestamps() {
+  if (gpu_timestamp_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  while (!gpu_timestamp_pending_.empty() &&
+         gpu_timestamp_pending_.front().submission <= submission_completed_) {
+    const GpuTimestampPending pending = gpu_timestamp_pending_.front();
+    gpu_timestamp_pending_.pop_front();
+    uint64_t ticks[2];
+    if (dfn.vkGetQueryPoolResults(vulkan_device->device(), gpu_timestamp_pool_, pending.slot * 2, 2,
+                                  sizeof(ticks), ticks, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      ++gpu_timestamp_untimed_;
+      continue;
+    }
+    if (pending.frame != gpu_timestamp_frame_) {
+      if (gpu_timestamp_frame_ != UINT64_MAX) {
+        gpu_timestamp_frame_ms_.push_back(float(gpu_timestamp_frame_ns_ / 1e6));
+        const float frame_ms = float(gpu_timestamp_frame_ns_ / 1e6);
+        gpu_timestamp_recent_ms_ = gpu_timestamp_recent_ms_ > 0.0f
+                                       ? gpu_timestamp_recent_ms_ + 0.1f * (frame_ms - gpu_timestamp_recent_ms_)
+                                       : frame_ms;
+        REXCVAR_SET(gpu_recent_frame_us, int32_t(gpu_timestamp_recent_ms_ * 1000.0f));
+        if (gpu_timestamp_previous_end_) {
+          gpu_timestamp_interval_ms_.push_back(
+              float(double((gpu_timestamp_frame_end_ - gpu_timestamp_previous_end_) & gpu_timestamp_mask_) *
+                    gpu_timestamp_ns_per_tick_ / 1e6));
+        }
+        gpu_timestamp_previous_end_ = gpu_timestamp_frame_end_;
+      }
+      gpu_timestamp_frame_ = pending.frame;
+      gpu_timestamp_frame_ns_ = 0.0;
+    }
+    gpu_timestamp_frame_end_ = ticks[1];
+    if (gpu_timestamp_last_submission_end_) {
+      const uint64_t gap = (ticks[0] - gpu_timestamp_last_submission_end_) & gpu_timestamp_mask_;
+      // A start before the previous end (wrapped by the mask) is not a gap.
+      if (gap < (gpu_timestamp_mask_ >> 1)) {
+        gpu_timestamp_idle_ns_ += double(gap) * gpu_timestamp_ns_per_tick_;
+        ++gpu_timestamp_idle_gaps_;
+      }
+    }
+    gpu_timestamp_last_submission_end_ = ticks[1];
+    gpu_timestamp_frame_ns_ +=
+        double((ticks[1] - ticks[0]) & gpu_timestamp_mask_) * gpu_timestamp_ns_per_tick_;
+    ++gpu_timestamp_submissions_;
+  }
+  while (!gpu_section_pending_.empty() && gpu_section_pending_.front().submission <= submission_completed_) {
+    const GpuSectionPending pending = std::move(gpu_section_pending_.front());
+    gpu_section_pending_.pop_front();
+    const uint32_t count = uint32_t(pending.sections.size()) + 1;
+    std::vector<uint64_t> ticks(count);
+    if (dfn.vkGetQueryPoolResults(vulkan_device->device(), gpu_section_pool_,
+                                  pending.slot * kGpuSectionQueries, count, sizeof(uint64_t) * count,
+                                  ticks.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    static const char* const kSectionNames[] = {"draws", "transfer", "resolve", "texture load", "texture copy"};
+    const bool timeline = pending.labels.size() == pending.sections.size() && !pending.labels.empty();
+    for (size_t i = 0; i + 1 < count; ++i) {
+      const double ns = double((ticks[i + 1] - ticks[i]) & gpu_timestamp_mask_) * gpu_timestamp_ns_per_tick_;
+      gpu_section_ns_[pending.sections[i]] += ns;
+      if (timeline) {
+        REXGPU_INFO("[gpu-pass] frame {} submission {} #{} {} | {} | draws {} | {:.1f} us", pending.frame,
+                    pending.submission, i, kSectionNames[pending.sections[i]], pending.labels[i], pending.draws[i],
+                    ns / 1000.0);
+      }
+    }
+  }
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(now - gpu_timestamp_log_time_).count();
+  if (seconds < 10.0 || gpu_timestamp_frame_ms_.empty()) {
+    return;
+  }
+  std::vector<float> ms = std::move(gpu_timestamp_frame_ms_);
+  gpu_timestamp_frame_ms_.clear();
+  std::sort(ms.begin(), ms.end());
+  double sum = 0.0;
+  for (float v : ms) {
+    sum += v;
+  }
+  auto at = [&ms](double p) { return ms[std::min(ms.size() - 1, size_t(p * double(ms.size() - 1) + 0.5))]; };
+  REXGPU_INFO(
+      "[gpu-time] {:.1f} s: {} frames, GPU ms per frame mean {:.3f} p50 {:.3f} p95 {:.3f} p99 {:.3f} max {:.3f}; "
+      "submissions {}, not timed {}",
+      seconds, ms.size(), sum / double(ms.size()), at(0.50), at(0.95), at(0.99), ms.back(),
+      gpu_timestamp_submissions_, gpu_timestamp_untimed_);
+  REXGPU_INFO("[gpu-time] GPU idle between submissions: {:.3f} ms per frame ({:.1f} % of the {:.1f} s)",
+              gpu_timestamp_idle_ns_ / 1e6 / double(ms.size()), 100.0 * gpu_timestamp_idle_ns_ / 1e9 / seconds,
+              seconds);
+  gpu_timestamp_idle_ns_ = 0.0;
+  gpu_timestamp_idle_gaps_ = 0;
+  if (!gpu_timestamp_interval_ms_.empty()) {
+    std::vector<float> iv = std::move(gpu_timestamp_interval_ms_);
+    gpu_timestamp_interval_ms_.clear();
+    std::sort(iv.begin(), iv.end());
+    double iv_sum = 0.0, iv_sq = 0.0;
+    for (float v : iv) {
+      iv_sum += v;
+      iv_sq += double(v) * v;
+    }
+    const double iv_mean = iv_sum / double(iv.size());
+    auto iv_at = [&iv](double p) { return iv[std::min(iv.size() - 1, size_t(p * double(iv.size() - 1) + 0.5))]; };
+    REXGPU_INFO(
+        "[gpu-time] frame completion interval ms: mean {:.3f} stdev {:.3f} p1 {:.3f} p50 {:.3f} p95 {:.3f} p99 {:.3f} "
+        "max {:.3f}",
+        iv_mean, std::sqrt(std::max(0.0, iv_sq / double(iv.size()) - iv_mean * iv_mean)), iv_at(0.01), iv_at(0.50),
+        iv_at(0.95), iv_at(0.99), iv.back());
+  }
+  if (gpu_section_pool_ != VK_NULL_HANDLE) {
+    const double frames = double(ms.size());
+    REXGPU_INFO(
+        "[gpu-time] sections per frame: draws {:.3f} ms, transfers {:.3f} ms ({:.1f} per frame), resolves {:.3f} ms "
+        "({:.1f} per frame), texture loads {:.3f} ms ({:.1f} per frame), texture copies into images {:.3f} ms; "
+        "submissions over {} timestamps {}",
+        gpu_section_ns_[kGpuSectionDraw] / 1e6 / frames, gpu_section_ns_[kGpuSectionTransfer] / 1e6 / frames,
+        gpu_section_entries_[kGpuSectionTransfer] / frames, gpu_section_ns_[kGpuSectionResolve] / 1e6 / frames,
+        gpu_section_entries_[kGpuSectionResolve] / frames, gpu_section_ns_[kGpuSectionTextureLoad] / 1e6 / frames,
+        gpu_section_entries_[kGpuSectionTextureLoad] / frames, gpu_section_ns_[kGpuSectionTextureCopy] / 1e6 / frames,
+        kGpuSectionQueries, gpu_section_overflows_);
+    for (uint32_t i = 0; i < kGpuSectionCount; ++i) {
+      gpu_section_ns_[i] = 0.0;
+      gpu_section_entries_[i] = 0;
+    }
+  }
+  {
+    const DeferredCommandBuffer::ExecuteStats c = deferred_command_buffer_.TakeStats();
+    const double f = double(ms.size());
+    const DrawExtentEstimator::VertexEstimateStats v = DrawExtentEstimator::TakeVertexEstimateStats();
+    REXGPU_INFO("[gpu-time] CPU vertex shader estimates per frame: {:.1f} draws, {:.1f} indices, {:.3f} ms",
+                v.draws / f, v.indices / f, v.ns / 1e6 / f);
+    REXGPU_INFO(
+        "[gpu-time] commands per frame: draws {:.1f} (indexed {:.1f}), render passes {:.1f}, pipeline binds {:.1f}, "
+        "descriptor set binds {:.1f}, push constants {:.1f}, pipeline barriers {:.1f} (image {:.1f}, buffer {:.1f}, "
+        "memory {:.1f}), dispatches {:.1f}, buffer copies {:.1f}, buffer-to-image copies {:.1f}, clears {:.1f}, "
+        "dynamic state {:.1f}, vertex/index binds {:.1f}",
+        c.draws / f, c.draws_indexed / f, c.render_passes / f, c.bind_pipelines / f, c.bind_descriptor_sets / f,
+        c.push_constants / f, c.pipeline_barriers / f, c.image_barriers / f, c.buffer_barriers / f,
+        c.memory_barriers / f, c.dispatches / f, c.copy_buffers / f, c.copy_buffer_to_images / f, c.clears / f,
+        c.dynamic_state / f, c.bind_buffers / f);
+    gpu_section_overflows_ = 0;
+  }
+  gpu_timestamp_submissions_ = 0;
+  gpu_timestamp_untimed_ = 0;
+  gpu_timestamp_log_time_ = now;
+}
+
+uint32_t VulkanCommandProcessor::SetGpuSection(uint32_t section) {
+  const uint32_t previous = gpu_section_current_;
+  if (section == previous) {
+    return previous;
+  }
+  gpu_section_current_ = section;
+  ++gpu_section_entries_[section];
+  if (!gpu_section_active_) {
+    return previous;
+  }
+  // The last query of the slot is kept for the submission's end.
+  if (gpu_section_intervals_.size() + 2 >= kGpuSectionQueries) {
+    return previous;
+  }
+  gpu_section_intervals_.push_back(uint8_t(previous));
+  CloseGpuPassInterval();
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_section_pool_,
+                                               gpu_section_slot_ * kGpuSectionQueries +
+                                                   uint32_t(gpu_section_intervals_.size()));
+  return previous;
+}
+
+void VulkanCommandProcessor::CloseGpuPassInterval() {
+  if (!gpu_pass_timing_active_) {
+    return;
+  }
+  const uint64_t draws = deferred_command_buffer_.recorded_draws();
+  gpu_section_labels_.push_back(gpu_pass_label_);
+  gpu_section_draws_.push_back(uint32_t(draws - gpu_pass_draws_at_mark_));
+  gpu_pass_draws_at_mark_ = draws;
+}
+
+void VulkanCommandProcessor::MarkGpuPass(bool render_target_cache_pass) {
+  if (!gpu_pass_timing_active_ || !gpu_section_active_ ||
+      gpu_section_intervals_.size() + 2 >= kGpuSectionQueries) {
+    return;
+  }
+  std::string label = render_target_cache_pass ? "rt-cache pass"
+                                               : "pass" + render_target_cache_->DiagLastUpdateLabel();
+  gpu_section_intervals_.push_back(uint8_t(gpu_section_current_));
+  CloseGpuPassInterval();
+  gpu_pass_label_ = std::move(label);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_section_pool_,
+                                               gpu_section_slot_ * kGpuSectionQueries +
+                                                   uint32_t(gpu_section_intervals_.size()));
+}
+
+void VulkanCommandProcessor::BeginGpuSections() {
+  gpu_section_active_ = false;
+  if (gpu_section_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const uint64_t submission = GetCurrentSubmission();
+  if (!gpu_section_pending_.empty() && gpu_section_pending_.front().submission + kGpuSectionSlots <= submission) {
+    return;
+  }
+  gpu_section_active_ = true;
+  gpu_section_slot_ = uint32_t(submission % kGpuSectionSlots);
+  gpu_section_intervals_.clear();
+  gpu_pass_timing_active_ = REXCVAR_GET(gpu_trace_pass_timing) && DiagTracing();
+  gpu_section_labels_.clear();
+  gpu_section_draws_.clear();
+  gpu_pass_label_ = "(submission start)";
+  gpu_pass_draws_at_mark_ = deferred_command_buffer_.recorded_draws();
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, gpu_section_pool_,
+                                               gpu_section_slot_ * kGpuSectionQueries);
+}
+
+void VulkanCommandProcessor::EndGpuSections(VkCommandBuffer command_buffer, uint64_t submission, bool submitted) {
+  if (command_buffer == VK_NULL_HANDLE) {
+    // After the submission: queue the recorded intervals for reading back.
+    if (gpu_section_recorded_ && submitted) {
+      gpu_section_pending_.push_back({submission, frame_current_, gpu_section_slot_, gpu_section_intervals_,
+                                      gpu_section_labels_, gpu_section_draws_});
+    }
+    gpu_section_recorded_ = false;
+    return;
+  }
+  if (!gpu_section_active_) {
+    return;
+  }
+  gpu_section_active_ = false;
+  gpu_section_recorded_ = true;
+  {
+    // The submission's last interval, written after the deferred commands.
+    gpu_section_intervals_.push_back(uint8_t(gpu_section_current_));
+    CloseGpuPassInterval();
+    GetVulkanDevice()->functions().vkCmdWriteTimestamp(
+        command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_section_pool_,
+        gpu_section_slot_ * kGpuSectionQueries + uint32_t(gpu_section_intervals_.size()));
+    if (gpu_section_intervals_.size() + 2 >= kGpuSectionQueries) {
+      ++gpu_section_overflows_;
+    }
+  }
+}
