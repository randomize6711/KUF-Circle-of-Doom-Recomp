KUF port (M12): type-0 packets of consecutive registers written as one range

A type-0 packet that writes count consecutive registers (in this game mostly the shader constants) went through
WriteRegister once per register. It now goes through WriteRegisterRangeFromRing, the path the type-3 SET_CONSTANT
packets already take: the Vulkan backend writes float, bool / loop and fetch constant ranges in bulk with the same
invalidations, and every other register still one by one through WriteRegister. Packets that write one register
repeatedly are unchanged. Register values and state are the same; the GPU command thread does less work per draw.

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -756,10 +756,15 @@
 
   uint32_t base_index = (packet & 0x7FFF);
   uint32_t write_one_reg = (packet >> 15) & 0x1;
+  if (!write_one_reg) {
+    // Consecutive registers (mostly shader constants): the range write, which backends implement in bulk for the
+    // constant ranges (the same register values and invalidations as one WriteRegister per register).
+    WriteRegisterRangeFromRing(reader, base_index, count);
+    return true;
+  }
   for (uint32_t m = 0; m < count; m++) {
     uint32_t reg_data = reader->ReadAndSwap<uint32_t>();
-    uint32_t target_index = write_one_reg ? base_index : base_index + m;
-    WriteRegister(target_index, reg_data);
+    WriteRegister(base_index, reg_data);
   }
 
   return true;
