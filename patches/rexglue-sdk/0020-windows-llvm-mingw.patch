diff --git a/include/rex/hook.h b/include/rex/hook.h
index 4ce4f9b..e0563ed 100644
--- a/include/rex/hook.h
+++ b/include/rex/hook.h
@@ -28,41 +28,50 @@
 // Hook Macros
 //=============================================================================
 
+// MinGW-w64 (llvm-mingw): the linker's automatic DLL export leaves out every symbol named __imp_*, which is how guest
+// imports are named (__imp__XGetLanguage), so they are exported explicitly. (The library is linked with
+// --export-all-symbols so that the rest is still exported.)
+#if defined(__MINGW32__)
+#define REX_FUNC_EXPORT __attribute__((dllexport))
+#else
+#define REX_FUNC_EXPORT
+#endif
+
 // Hook a recompiled function with an auto-marshaled native C++ function.
 // The native function uses plain types (u32, mapped_u32, etc.) and
 // HostToGuestFunction handles register translation automatically.
 #ifdef REXGLUE_ENABLE_PROFILING
 #include <tracy/Tracy.hpp>
 #define REX_HOOK(subroutine, function)                           \
-  extern "C" REX_FUNC(subroutine) {                              \
+  extern "C" REX_FUNC_EXPORT REX_FUNC(subroutine) {                              \
     ZoneNamedN(___tracy_hook_zone, #subroutine, TracyIsStarted); \
     rex::ppc::HostToGuestFunction<function>(ctx, base);          \
   }
 #else
 #define REX_HOOK(subroutine, function)                  \
-  extern "C" REX_FUNC(subroutine) {                     \
+  extern "C" REX_FUNC_EXPORT REX_FUNC(subroutine) {                     \
     rex::ppc::HostToGuestFunction<function>(ctx, base); \
   }
 #endif
 
 // Define a raw hook with direct ctx/base access.
-#define REX_HOOK_RAW(name) extern "C" REX_FUNC(name)
+#define REX_HOOK_RAW(name) extern "C" REX_FUNC_EXPORT REX_FUNC(name)
 
 // Stub: logs a warning when called.
 #define REX_STUB(subroutine)              \
-  extern "C" REX_FUNC(subroutine) {       \
+  extern "C" REX_FUNC_EXPORT REX_FUNC(subroutine) {       \
     (void)base;                           \
     REXKRNL_WARN("{} STUB", #subroutine); \
   }
 
 #define REX_STUB_LOG(subroutine, msg)               \
-  extern "C" REX_FUNC(subroutine) {                 \
+  extern "C" REX_FUNC_EXPORT REX_FUNC(subroutine) {                 \
     (void)base;                                     \
     REXKRNL_WARN("{} STUB - {}", #subroutine, msg); \
   }
 
 #define REX_STUB_RETURN(subroutine, value)                                                \
-  extern "C" REX_FUNC(subroutine) {                                                       \
+  extern "C" REX_FUNC_EXPORT REX_FUNC(subroutine) {                                                       \
     (void)base;                                                                           \
     REXKRNL_WARN("{} STUB - returning {:#x}", #subroutine, static_cast<uint32_t>(value)); \
     ctx.r3.u64 = (value);                                                                 \
diff --git a/resources/templates/codegen/pch_h.inja b/resources/templates/codegen/pch_h.inja
index 68274d2..1bd363c 100644
--- a/resources/templates/codegen/pch_h.inja
+++ b/resources/templates/codegen/pch_h.inja
@@ -266,18 +266,24 @@ extern PPCFuncMapping PPCFuncMappings[];
 // Setjmp/Longjmp
 //=============================================================================
 
-inline std::unordered_map<u32, jmp_buf>& get_jmp_buf_map() {
-  static thread_local std::unordered_map<u32, jmp_buf> map;
+// A jmp_buf in its own 16-byte aligned struct: Windows x64 setjmp saves the XMM registers with aligned stores, and as
+// an unordered_map value a bare jmp_buf (an array of a type aligned by typedef) is only 8-byte aligned under libc++.
+struct alignas(16) PPCJmpBuf {
+  jmp_buf buf;
+};
+
+inline std::unordered_map<u32, PPCJmpBuf>& get_jmp_buf_map() {
+  static thread_local std::unordered_map<u32, PPCJmpBuf> map;
   return map;
 }
 
-#define ppc_setjmp(guest_buf_addr) (setjmp(::get_jmp_buf_map()[(guest_buf_addr)]))
+#define ppc_setjmp(guest_buf_addr) (setjmp(::get_jmp_buf_map()[(guest_buf_addr)].buf))
 
 [[noreturn]] inline void ppc_longjmp(u32 guest_buf_addr, int val) {
   auto& map = get_jmp_buf_map();
   auto it = map.find(guest_buf_addr);
   if (it != map.end()) {
-    longjmp(it->second, val);
+    longjmp(it->second.buf, val);
   }
   std::abort();
 }
diff --git a/resources/templates/init/rexglue_cmake.inja b/resources/templates/init/rexglue_cmake.inja
index f39557b..a2edb36 100644
--- a/resources/templates/init/rexglue_cmake.inja
+++ b/resources/templates/init/rexglue_cmake.inja
@@ -114,10 +114,22 @@ endmacro()
 # codegen, including one a project assembles itself rather than taking the
 # library rexglue_setup_target() builds. The stamp comes first: the DEPFILE
 # names it.
+#
+# A cross build (for example Windows from Linux) runs the build machine's code
+# generator, never the target's program: REXGLUE_HOST_REXGLUE names it. The
+# output is plain C++, the same on every system.
+if(CMAKE_CROSSCOMPILING AND NOT CMAKE_SYSTEM_NAME STREQUAL CMAKE_HOST_SYSTEM_NAME)
+    if(NOT REXGLUE_HOST_REXGLUE OR NOT EXISTS "{{ cmake_var("REXGLUE_HOST_REXGLUE") }}")
+        message(FATAL_ERROR "A cross build needs -DREXGLUE_HOST_REXGLUE=<a native build>/bin/rexglue")
+    endif()
+    set(_rexglue_codegen_tool "{{ cmake_var("REXGLUE_HOST_REXGLUE") }}")
+else()
+    set(_rexglue_codegen_tool $<TARGET_FILE:rex::rexglue>)
+endif()
 add_custom_command(
     OUTPUT "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.build.stamp"
            {{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }}
-    COMMAND $<TARGET_FILE:rex::rexglue> codegen {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ names.snake_case }}_manifest.toml
+    COMMAND {{ cmake_var("_rexglue_codegen_tool") }} codegen {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ names.snake_case }}_manifest.toml
     DEPFILE "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.d"
     WORKING_DIRECTORY {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
     COMMENT "Generating recompiled code for {{ names.snake_case }}"
