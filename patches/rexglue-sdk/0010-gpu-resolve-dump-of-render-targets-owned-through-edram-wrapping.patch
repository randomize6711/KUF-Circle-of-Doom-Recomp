+                                    uint32_t pitch, uint32_t row_length,
+                                    uint32_t range_local_offset,
+                                    std::vector<ResolveCopyDumpRectangle>& rectangles_out) {
+      uint32_t part_starts[2] = {range_start, rt_base};
+      uint32_t part_ends[2] = {rt_base, range_end};
+      if (range_start >= rt_base || range_end <= rt_base) {
+        part_ends[0] = range_end;
+        part_starts[1] = part_ends[1];
+      }
+      for (uint32_t part = 0; part < 2; ++part) {
+        if (part_starts[part] >= part_ends[part]) {
+          continue;
+        }
+        uint32_t range_local_start = range_local_offset + part_starts[part] - base;
+        uint32_t range_local_end = range_local_offset + part_ends[part] - base;
+        assert_true(range_local_start < range_local_end);
+
+        uint32_t rows_start = range_local_start / pitch;
+        uint32_t rows_end = (range_local_end + (pitch - 1)) / pitch;
+        uint32_t row_first_start = range_local_start - rows_start * pitch;
+        if (row_first_start >= row_length) {
+          // The first row starts within the pitch padding.
+          if (rows_start + 1 < rows_end) {
+            // Multiple rows - start at the second.
+            ++rows_start;
+            row_first_start = 0;
+          } else {
