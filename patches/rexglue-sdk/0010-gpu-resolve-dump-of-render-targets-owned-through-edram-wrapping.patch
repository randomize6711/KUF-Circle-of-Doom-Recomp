-        dispatch_mid.offset = mid_row_first * pitch_tiles;
+        dispatch_mid.offset = mid_row_first * pitch_tiles + source_period_offset_tiles;
         dispatch_mid.width_tiles = row_length_used;
         dispatch_mid.height_tiles = mid_rows;
       }
