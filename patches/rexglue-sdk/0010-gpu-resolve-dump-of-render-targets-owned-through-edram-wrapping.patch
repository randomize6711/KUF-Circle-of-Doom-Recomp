+      }
+    }
     struct Dispatch {
       // Base plus offset may exceed the EDRAM tile count in case of EDRAM
-      // addressing wrapping.
+      // addressing wrapping. It is in the addressing period of the render
+      // target being dumped (from its base tile up to the base plus the EDRAM
+      // tile count).
       uint32_t offset;
       uint32_t width_tiles;
       uint32_t height_tiles;
@@ -419,7 +492,7 @@ class RenderTargetCache {
       uint32_t dispatch_count = 0;
       if (rows == 1 || row_first_start) {
         Dispatch& dispatch_first = dispatches_out[dispatch_count++];
-        dispatch_first.offset = row_first * pitch_tiles + row_first_start;
+        dispatch_first.offset = row_first * pitch_tiles + row_first_start + source_period_offset_tiles;
         dispatch_first.width_tiles = (rows == 1 ? row_last_end : row_length_used) - row_first_start;
         dispatch_first.height_tiles = 1;
         if (rows == 1) {
@@ -437,13 +510,13 @@ class RenderTargetCache {
