+        // tile index in the current EDRAM addressing period; the render target
+        // needs it in its own period.
+        uint32_t rt_period_offset = part_starts[part] < rt_base ? xenos::kEdramTileCount : 0;
+        // Don't include pitch padding in the last row.
+        uint32_t row_last_end = pitch - (rows_end * pitch - range_local_end);
+        rectangles_out.emplace_back(render_target, rows_start, rows_end - rows_start,
