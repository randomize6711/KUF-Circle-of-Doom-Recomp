diff --git a/include/rex/system/xam/content_transaction.h b/include/rex/system/xam/content_transaction.h
new file mode 100644
index 0000000..3e72a91
--- /dev/null
+++ b/include/rex/system/xam/content_transaction.h
@@ -0,0 +1,104 @@
+/**
+ * Transactional content packages (kuf-cod-recomp patch).
+ *
+ * The runtime stores an Xbox 360 content package (a save) as a host directory and mounts it as a guest
+ * device. Without transactions the guest writes straight into that directory, so a crash or a kill while
+ * the game saves can leave a half-written save, and CREATE_ALWAYS deletes the old save before the new one
+ * exists. On the console, content writes become visible when the package is closed or flushed.
+ *
+ * Here the guest works on a staging copy next to the package (<package>.rex-staging). Commit makes the
+ * staging copy the package in one atomic step (rename, or renameat2 RENAME_EXCHANGE when a package
+ * exists), after the data is synced to disk. Whatever moment the process dies, the package directory is
+ * either the previous committed version or the new one, never a mix. A staging directory left over by an
+ * interrupted session is never loaded; recovery moves it aside as <package>.rex-interrupted (diagnostics
+ * only, one per package).
+ *
+ * A manifest (.rex-manifest: size and SHA-256 of every file) is committed with the package, so damage
+ * from outside (disk errors, partial copies, edits) is detected when the package is opened.
+ *
+ * Pure std::filesystem/POSIX code without runtime state, unit-tested by the kuf-cod-recomp test suite.
+ */
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rex::system::xam::content_txn {
+
+inline constexpr std::string_view kStagingSuffix = ".rex-staging";
+inline constexpr std::string_view kInterruptedSuffix = ".rex-interrupted";
+inline constexpr std::string_view kPreviousSuffix = ".rex-previous";
+inline constexpr std::string_view kDamagedSuffix = ".rex-damaged";
+inline constexpr std::string_view kManifestName = ".rex-manifest";
+
+// True for host entries the runtime manages beside or inside packages (never guest content).
+bool IsInternalName(std::string_view name);
+
+std::filesystem::path StagingPath(const std::filesystem::path& package);
+
+enum class BeginMode {
+  kCreate,   // new package: empty staging directory
+  kOpen,     // existing package: staging starts as a copy of it
+  kReplace,  // CREATE_ALWAYS / TRUNCATE_EXISTING: empty staging; the old package stays until commit
+};
+
+// Prepares the staging directory. A leftover staging directory (an interrupted session that was not
+// recovered) is moved aside first. False with *error if the copy or the directory creation failed.
+bool Begin(const std::filesystem::path& package, BeginMode mode, std::string* error);
+
+struct CommitResult {
+  bool ok = false;
+  bool changed = false;  // false: staging was identical to the package, nothing replaced
+  size_t files = 0;
+  uint64_t bytes = 0;
+  std::vector<std::string> changed_files;  // files added, modified ("~") or removed ("-") by this commit
+  std::string error;
+};
+
+// Close: makes staging the package (atomic swap), removes staging. On failure the package is unchanged
+// and staging is left for recovery.
+CommitResult Commit(const std::filesystem::path& package);
+// Flush: the same for a copy of staging, which stays mounted.
+CommitResult Snapshot(const std::filesystem::path& package);
+// Discards staging (the package stays as it was).
+void Abort(const std::filesystem::path& package);
+
+// Verification of a committed package against its manifest.
+enum class Integrity { kOk, kNoManifest, kDamaged };
+Integrity Verify(const std::filesystem::path& package, std::string* detail);
+
+// The game deletes a package (e.g. the player chose "delete the corrupted save file"): a package that fails
+// verification is moved aside to <package>.rex-damaged (replacing an older one; never loaded) instead of
+// being erased, so its data stays available for manual recovery. Returns true if it was moved.
+bool SetAsideIfDamaged(const std::filesystem::path& package);
+
+// Recovery for one directory of packages (a content-type root), for what a previous session left:
+//  - a staging directory identical to its package (the session ended without uncommitted writes; games
+//    often keep their save package open until they exit): removed;
+//  - a staging directory with uncommitted changes (the session ended while the game was writing, or wrote
+//    without flushing): never applied, moved aside to <package>.rex-interrupted (replacing an older one);
+//  - <package>.rex-previous (a commit interrupted between its two renames, only without RENAME_EXCHANGE):
+//    restored if the package is missing, else removed; an unfinished flush copy: removed.
+struct RecoveryNote {
+  bool warning;  // false: routine cleanup
+  std::string text;
+};
+std::vector<RecoveryNote> Recover(const std::filesystem::path& package_root);
+
+// Writes a whole file atomically (temp file, fsync, rename, fsync of the directory).
+bool AtomicWriteFile(const std::filesystem::path& file, std::span<const uint8_t> data, std::string* error);
+
+// Test hook: called at points of a commit that changes the package ("changed": the guest's new data is
+// complete in staging, nothing is committed yet; "install": the new version is written and synced, right
+// before the atomic swap). Interrupted-save tests kill the process there. nullptr = none.
+using CommitHook = void (*)(const char* stage, const std::filesystem::path& package);
+void SetCommitHook(CommitHook hook);
+
+// SHA-256 of a byte range (lowercase hex). Exposed for tests.
+std::string Sha256Hex(std::span<const uint8_t> data);
+
+}  // namespace rex::system::xam::content_txn
