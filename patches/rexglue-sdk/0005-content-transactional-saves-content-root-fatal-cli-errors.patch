+// --- SHA-256 (FIPS 180-4), small and dependency-free ------------------------------------------------
+class Sha256 {
+ public:
+  Sha256() { Reset(); }
+  void Reset() {
+    h_ = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+    len_ = 0;
+    used_ = 0;
+  }
+  void Update(const uint8_t* p, size_t n) {
+    len_ += n;
+    while (n) {
+      size_t take = std::min(n, size_t(64) - used_);
+      std::memcpy(buf_.data() + used_, p, take);
+      used_ += take;
+      p += take;
+      n -= take;
+      if (used_ == 64) {
+        Block(buf_.data());
+        used_ = 0;
+      }
+    }
+  }
+  std::string HexDigest() {
+    uint64_t bits = len_ * 8;
+    uint8_t pad = 0x80;
+    Update(&pad, 1);
+    uint8_t zero = 0;
+    while (used_ != 56) Update(&zero, 1);
+    uint8_t lenbuf[8];
+    for (int i = 0; i < 8; ++i) lenbuf[i] = uint8_t(bits >> (56 - 8 * i));
+    Update(lenbuf, 8);
+    static const char* kHex = "0123456789abcdef";
+    std::string out;
+    for (uint32_t v : h_) {
+      for (int i = 3; i >= 0; --i) {
+        uint8_t b = uint8_t(v >> (8 * i));
+        out += kHex[b >> 4];
+        out += kHex[b & 15];
+      }
+    }
+    return out;
+  }
+
+ private:
+  static uint32_t Rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+  void Block(const uint8_t* p) {
+    static constexpr uint32_t k[64] = {
+        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+    uint32_t w[64];
+    for (int i = 0; i < 16; ++i) {
+      w[i] = uint32_t(p[4 * i]) << 24 | uint32_t(p[4 * i + 1]) << 16 | uint32_t(p[4 * i + 2]) << 8 |
+             uint32_t(p[4 * i + 3]);
+    }
+    for (int i = 16; i < 64; ++i) {
+      uint32_t s0 = Rotr(w[i - 15], 7) ^ Rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+      uint32_t s1 = Rotr(w[i - 2], 17) ^ Rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+      w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+    uint32_t a = h_[0], b = h_[1], c = h_[2], d = h_[3], e = h_[4], f = h_[5], g = h_[6], h = h_[7];
+    for (int i = 0; i < 64; ++i) {
+      uint32_t t1 = h + (Rotr(e, 6) ^ Rotr(e, 11) ^ Rotr(e, 25)) + ((e & f) ^ (~e & g)) + k[i] + w[i];
+      uint32_t t2 = (Rotr(a, 2) ^ Rotr(a, 13) ^ Rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+      h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+    }
+    h_[0] += a; h_[1] += b; h_[2] += c; h_[3] += d; h_[4] += e; h_[5] += f; h_[6] += g; h_[7] += h;
+  }
+  std::array<uint32_t, 8> h_;
+  std::array<uint8_t, 64> buf_;
+  uint64_t len_;
+  size_t used_;
+};
+
+std::string Suffixed(const fs::path& package, std::string_view suffix) {
+  return package.filename().string() + std::string(suffix);
+}
+fs::path Sibling(const fs::path& package, std::string_view suffix) {
+  return package.parent_path() / Suffixed(package, suffix);
+}
+
+bool FsyncPath(const fs::path& path, bool directory) {
+  int fd = ::open(path.c_str(), (directory ? O_RDONLY | O_DIRECTORY : O_RDONLY) | O_CLOEXEC);
+  if (fd < 0) return false;
+  bool ok = ::fsync(fd) == 0;
+  ::close(fd);
+  return ok;
+}
+
+// Relative path -> file content digest and size, for every regular file below `dir` (the manifest itself
+// excluded).
+struct FileDigest {
+  uint64_t size = 0;
+  std::string sha256;
+  bool operator==(const FileDigest&) const = default;
+};
+using Tree = std::map<std::string, FileDigest>;
+
+bool HashFile(const fs::path& file, FileDigest* out) {
+  std::ifstream in(file, std::ios::binary);
+  if (!in) return false;
+  Sha256 sha;
+  std::array<char, 65536> buf;
+  uint64_t size = 0;
+  while (in) {
+    in.read(buf.data(), buf.size());
+    auto n = static_cast<size_t>(in.gcount());
+    sha.Update(reinterpret_cast<const uint8_t*>(buf.data()), n);
+    size += n;
+  }
+  if (in.bad()) return false;
+  out->size = size;
+  out->sha256 = sha.HexDigest();
+  return true;
+}
+
+bool ScanTree(const fs::path& dir, Tree* out, std::string* error) {
+  std::error_code ec;
+  if (!fs::is_directory(dir, ec)) {
+    if (error) *error = "not a directory: " + dir.string();
+    return false;
+  }
+  for (auto it = fs::recursive_directory_iterator(dir, ec); !ec && it != fs::recursive_directory_iterator();
+       it.increment(ec)) {
+    if (!it->is_regular_file(ec)) continue;
+    auto rel = fs::relative(it->path(), dir, ec).generic_string();
+    if (ec) break;
+    if (rel == kManifestName) continue;
+    FileDigest d;
+    if (!HashFile(it->path(), &d)) {
+      if (error) *error = "cannot read " + it->path().string();
+      return false;
+    }
+    (*out)[rel] = std::move(d);
+  }
+  if (ec) {
+    if (error) *error = "cannot list " + dir.string() + ": " + ec.message();
+    return false;
+  }
+  return true;
+}
+
+std::string ManifestText(const Tree& tree) {
+  std::ostringstream s;
+  s << "rex-content-manifest 1\n";
+  for (const auto& [rel, d] : tree) s << d.sha256 << ' ' << d.size << ' ' << rel << '\n';
+  return s.str();
+}
+
+bool ParseManifest(const fs::path& file, Tree* out) {
+  std::ifstream in(file);
+  std::string line;
+  if (!std::getline(in, line) || line != "rex-content-manifest 1") return false;
+  while (std::getline(in, line)) {
+    std::istringstream ls(line);
+    FileDigest d;
+    std::string rel;
+    if (!(ls >> d.sha256 >> d.size) || d.sha256.size() != 64) return false;
+    ls.get();
+    std::getline(ls, rel);
+    if (rel.empty()) return false;
+    (*out)[rel] = d;
+  }
+  return true;
+}
+
+bool CopyTree(const fs::path& from, const fs::path& to, std::string* error) {
+  std::error_code ec;
+  fs::create_directories(to, ec);
+  if (!ec) fs::copy(from, to, fs::copy_options::recursive | fs::copy_options::overwrite_existing, ec);
+  if (ec) {
+    if (error) *error = "copy " + from.string() + " -> " + to.string() + ": " + ec.message();
+    return false;
+  }
+  fs::remove(to / kManifestName, ec);  // rewritten at commit
+  return true;
+}
+
+bool SyncTree(const fs::path& dir) {
+  std::error_code ec;
+  bool ok = true;
+  for (auto it = fs::recursive_directory_iterator(dir, ec); !ec && it != fs::recursive_directory_iterator();
+       it.increment(ec)) {
+    ok &= FsyncPath(it->path(), it->is_directory(ec));
+  }
+  return ok && !ec && FsyncPath(dir, true);
+}
+
+int RenameExchange(const fs::path& a, const fs::path& b) {
+#ifdef SYS_renameat2
+  return static_cast<int>(::syscall(SYS_renameat2, AT_FDCWD, a.c_str(), AT_FDCWD, b.c_str(), RENAME_EXCHANGE));
+#else
+  errno = ENOSYS;
+  return -1;
+#endif
+}
+
+// Moves `from` (a complete, synced tree with manifest) into place as `package`.
+bool Install(const fs::path& from, const fs::path& package, std::string* error) {
+  std::error_code ec;
+  const fs::path parent = package.parent_path();
+  if (!fs::exists(package, ec)) {
+    if (::rename(from.c_str(), package.c_str()) != 0) {
+      if (error) *error = "rename " + from.string() + ": " + std::strerror(errno);
+      return false;
+    }
+    FsyncPath(parent, true);
+    return true;
+  }
+  if (RenameExchange(from, package) == 0) {
+    FsyncPath(parent, true);
+    fs::remove_all(from, ec);  // now the previous version
+    FsyncPath(parent, true);
+    return true;
+  }
+  // No RENAME_EXCHANGE (old kernel or filesystem): previous version aside, then the new one in. A crash
+  // between the two renames leaves <package>.rex-previous, which Recover() moves back.
+  const fs::path previous = Sibling(package, kPreviousSuffix);
+  fs::remove_all(previous, ec);
+  if (::rename(package.c_str(), previous.c_str()) != 0) {
+    if (error) *error = "rename " + package.string() + ": " + std::strerror(errno);
+    return false;
+  }
+  if (::rename(from.c_str(), package.c_str()) != 0) {
+    if (error) *error = "rename " + from.string() + ": " + std::strerror(errno);
+    ::rename(previous.c_str(), package.c_str());
+    return false;
+  }
+  FsyncPath(parent, true);
+  fs::remove_all(previous, ec);
+  FsyncPath(parent, true);
+  return true;
+}
+
+CommitHook g_commit_hook = nullptr;
+
+CommitResult CommitFrom(const fs::path& staging, const fs::path& package, bool keep_staging) {
+  CommitResult result;
+  Tree tree;
+  if (!ScanTree(staging, &tree, &result.error)) return result;
+  for (const auto& [rel, d] : tree) {
+    ++result.files;
+    result.bytes += d.size;
+  }
+  Tree current;
+  std::error_code ec;
+  const bool have_current = fs::exists(package, ec) && ScanTree(package, &current, nullptr);
+  if (have_current && current == tree && Verify(package, nullptr) == Integrity::kOk) {
+    result.ok = true;  // nothing changed
+    if (!keep_staging) fs::remove_all(staging, ec);
+    return result;
+  }
+  for (const auto& [rel, d] : tree) {
+    auto it = current.find(rel);
+    if (it == current.end()) result.changed_files.push_back(rel);
+    else if (!(it->second == d)) result.changed_files.push_back("~" + rel);
+  }
+  for (const auto& [rel, d] : current) {
+    if (!tree.contains(rel)) result.changed_files.push_back("-" + rel);
+  }
+  if (g_commit_hook) g_commit_hook("changed", package);
+  fs::path source = staging;
+  if (keep_staging) {
+    source = Sibling(package, ".rex-snapshot");
+    fs::remove_all(source, ec);
+    if (!CopyTree(staging, source, &result.error)) return result;
+  }
+  const std::string text = ManifestText(tree);
+  if (!AtomicWriteFile(source / kManifestName,
+                       std::span(reinterpret_cast<const uint8_t*>(text.data()), text.size()),
+                       &result.error)) {
+    return result;
+  }
+  if (!SyncTree(source)) {
+    result.error = "fsync failed in " + source.string();
+    return result;
+  }
+  if (g_commit_hook) g_commit_hook("install", package);
+  if (!Install(source, package, &result.error)) return result;
+  result.ok = true;
+  result.changed = true;
+  return result;
+}
+
+}  // namespace
+
+bool IsInternalName(std::string_view name) {
+  return name.starts_with(".rex-") || name.ends_with(kStagingSuffix) || name.ends_with(kInterruptedSuffix) ||
+         name.ends_with(kPreviousSuffix) || name.ends_with(kDamagedSuffix) || name.ends_with(".rex-snapshot");
+}
+
+bool SetAsideIfDamaged(const fs::path& package) {
+  std::error_code ec;
+  if (!fs::is_directory(package, ec) || Verify(package, nullptr) != Integrity::kDamaged) return false;
+  const fs::path aside = Sibling(package, kDamagedSuffix);
+  fs::remove_all(aside, ec);
+  fs::rename(package, aside, ec);
+  return !ec;
+}
+
+fs::path StagingPath(const fs::path& package) { return Sibling(package, kStagingSuffix); }
+
+bool Begin(const fs::path& package, BeginMode mode, std::string* error) {
+  std::error_code ec;
+  const fs::path staging = StagingPath(package);
+  if (fs::exists(staging, ec)) {
+    const fs::path aside = Sibling(package, kInterruptedSuffix);
+    fs::remove_all(aside, ec);
+    fs::rename(staging, aside, ec);
+    if (ec) fs::remove_all(staging, ec);
+  }
+  if (mode == BeginMode::kOpen) return CopyTree(package, staging, error);
+  fs::create_directories(staging, ec);
+  if (ec && error) *error = "create " + staging.string() + ": " + ec.message();
+  return !ec;
+}
+
+CommitResult Commit(const fs::path& package) { return CommitFrom(StagingPath(package), package, false); }
+
+CommitResult Snapshot(const fs::path& package) { return CommitFrom(StagingPath(package), package, true); }
+
+void Abort(const fs::path& package) {
+  std::error_code ec;
+  fs::remove_all(StagingPath(package), ec);
+}
+
+Integrity Verify(const fs::path& package, std::string* detail) {
+  Tree expected;
+  std::error_code ec;
+  const fs::path manifest = package / kManifestName;
+  if (!fs::exists(manifest, ec)) return Integrity::kNoManifest;
+  if (!ParseManifest(manifest, &expected)) {
+    if (detail) *detail = "unreadable manifest";
+    return Integrity::kDamaged;
+  }
+  Tree actual;
+  std::string error;
+  if (!ScanTree(package, &actual, &error)) {
+    if (detail) *detail = error;
+    return Integrity::kDamaged;
+  }
+  if (actual == expected) return Integrity::kOk;
+  if (detail) {
+    std::ostringstream s;
+    for (const auto& [rel, d] : expected) {
+      auto it = actual.find(rel);
+      if (it == actual.end()) {
+        s << rel << ": missing; ";
+      } else if (it->second.size != d.size) {
+        s << rel << ": size " << it->second.size << ", expected " << d.size << "; ";
+      } else if (it->second.sha256 != d.sha256) {
+        s << rel << ": content differs; ";
+      }
+    }
+    for (const auto& [rel, d] : actual) {
+      if (!expected.count(rel)) s << rel << ": unexpected file; ";
+    }
+    *detail = s.str();
+  }
+  return Integrity::kDamaged;
+}
+
+std::vector<RecoveryNote> Recover(const fs::path& package_root) {
+  std::vector<RecoveryNote> notes;
+  std::error_code ec;
+  if (!fs::is_directory(package_root, ec)) return notes;
+  std::vector<fs::path> entries;
+  for (const auto& e : fs::directory_iterator(package_root, ec)) entries.push_back(e.path());
+  for (const auto& path : entries) {
+    const std::string name = path.filename().string();
+    auto strip = [&](std::string_view suffix) { return package_root / name.substr(0, name.size() - suffix.size()); };
+    if (name.ends_with(kPreviousSuffix)) {
+      const fs::path package = strip(kPreviousSuffix);
+      if (!fs::exists(package, ec)) {
+        fs::rename(path, package, ec);
+        notes.push_back({true, "restored " + package.filename().string() + " from an interrupted commit"});
+      } else {
+        fs::remove_all(path, ec);
+        notes.push_back({true, "removed the previous version of " + package.filename().string() +
+                                   " left by an interrupted commit"});
+      }
+    } else if (name.ends_with(".rex-snapshot")) {
+      fs::remove_all(path, ec);
+      notes.push_back(
+          {true, "removed an unfinished flush copy of " + strip(".rex-snapshot").filename().string()});
+    }
+  }
+  for (const auto& path : entries) {
+    const std::string name = path.filename().string();
+    if (!name.ends_with(kStagingSuffix) || !fs::exists(path, ec)) continue;
+    const fs::path package = package_root / name.substr(0, name.size() - kStagingSuffix.size());
+    Tree staged, committed;
+    if (fs::exists(package, ec) && ScanTree(path, &staged, nullptr) && ScanTree(package, &committed, nullptr) &&
+        staged == committed) {
+      fs::remove_all(path, ec);
+      notes.push_back({false, "removed the staging copy of " + package.filename().string() +
+                                  " (no uncommitted changes)"});
+      continue;
+    }
+    const fs::path aside = Sibling(package, kInterruptedSuffix);
+    fs::remove_all(aside, ec);
+    fs::rename(path, aside, ec);
+    if (ec) fs::remove_all(path, ec);
+    notes.push_back({true, "uncommitted changes to " + package.filename().string() +
+                               " from an interrupted session were not applied (kept as " +
+                               aside.filename().string() + "); the last committed version is used"});
+  }
+  return notes;
+}
+
+bool AtomicWriteFile(const fs::path& file, std::span<const uint8_t> data, std::string* error) {
+  const fs::path tmp = file.parent_path() / (".rex-tmp-" + file.filename().string());
+  int fd = ::open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0) {
+    if (error) *error = "open " + tmp.string() + ": " + std::strerror(errno);
+    return false;
+  }
+  size_t done = 0;
+  while (done < data.size()) {
+    ssize_t n = ::write(fd, data.data() + done, data.size() - done);
+    if (n < 0) {
+      if (errno == EINTR) continue;
+      break;
+    }
+    done += static_cast<size_t>(n);
+  }
+  bool ok = done == data.size() && ::fsync(fd) == 0;
+  ok &= ::close(fd) == 0;
+  if (ok) ok = ::rename(tmp.c_str(), file.c_str()) == 0;
+  if (!ok) {
+    if (error) *error = "write " + file.string() + ": " + std::strerror(errno);
+    ::unlink(tmp.c_str());
+    return false;
+  }
+  FsyncPath(file.parent_path(), true);
+  return true;
+}
+
+void SetCommitHook(CommitHook hook) { g_commit_hook = hook; }
+
+std::string Sha256Hex(std::span<const uint8_t> data) {
+  Sha256 sha;
+  sha.Update(data.data(), data.size());
+  return sha.HexDigest();
+}
