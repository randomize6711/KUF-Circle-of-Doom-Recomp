+// content_test_kill: the stage and the count of changed commits at which to die.
+std::string g_kill_stage;
+int g_kill_at = 0;
+int g_changed_commits = 0;
+int g_flushes = 0;
+void KillHook(const char* stage, const std::filesystem::path& package) {
+  if (std::string_view(stage) == "changed") {
