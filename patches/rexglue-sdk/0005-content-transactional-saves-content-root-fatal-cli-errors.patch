+    rex::FlushLogging();
+    std::raise(SIGKILL);
+  }
+}
+void FlushKillHook(const std::filesystem::path& package) {
+  if (g_kill_stage == "flush" && ++g_flushes == g_kill_at) {
+    REXKRNL_WARN("[content] TEST: killing the process at flush {} of {}", g_flushes,
+                 rex::path_to_utf8(package.filename()));
+    rex::FlushLogging();
+    std::raise(SIGKILL);
