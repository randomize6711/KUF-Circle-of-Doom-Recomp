+X_RESULT ContentManager::FlushContent(const std::string_view root_name) {
+  auto global_lock = global_critical_region_.Acquire();
+  auto it = open_packages_.find(string::string_key_case(root_name));
+  if (it == open_packages_.end()) {
+    REXKRNL_WARN("[content] flush '{}:': not open", root_name);
+    return X_ERROR_SUCCESS;  // as before transactions: flushing is never an error for the guest
+  }
+  auto* package = it->second;
+  if (!package->transactional()) {
+    return X_ERROR_SUCCESS;
+  }
+  FlushKillHook(package->package_path());
+  if (flush_group_depth_ > 0) {
+    held_flushes_.insert(string::string_key_case(root_name));
+    REXKRNL_INFO("[content] flush {}: held until the end of {}", Describe(package->GetPackageContentData()),
+                 flush_group_name_);
+    return X_ERROR_SUCCESS;
+  }
+  return CommitOpenPackage(package, "flush");
+}
+
+X_RESULT ContentManager::CommitOpenPackage(ContentPackage* package, std::string_view why) {
+  auto result = content_txn::Snapshot(package->package_path());
+  const auto what = Describe(package->GetPackageContentData());
+  if (!result.ok) {
+    REXKRNL_ERROR("[content] {} {} failed, the previous version stays: {}", why, what, result.error);
+    return X_ERROR_ACCESS_DENIED;
+  }
+  REXKRNL_INFO("[content] {} {}: {} ({} files, {} bytes{})", why, what, result.changed ? "committed" : "unchanged",
+               result.files, result.bytes, ChangedList(result));
   return X_ERROR_SUCCESS;
 }
 
+void ContentManager::BeginFlushGroup(std::string_view what) {
+  auto global_lock = global_critical_region_.Acquire();
+  if (flush_group_depth_++ == 0) {
+    flush_group_name_ = what;
+  }
+}
+
+void ContentManager::EndFlushGroup() {
+  auto global_lock = global_critical_region_.Acquire();
+  if (flush_group_depth_ == 0 || --flush_group_depth_ > 0) {
+    return;
+  }
+  const std::string why = "flush (" + flush_group_name_ + ")";
+  for (const auto& root_name : held_flushes_) {
+    auto it = open_packages_.find(root_name);
+    if (it == open_packages_.end()) {
+      continue;  // closed inside the group: committed by the close
+    }
+    if (it->second->transactional()) {
+      CommitOpenPackage(it->second, why);
+    }
+  }
+  held_flushes_.clear();
+}
+
+X_RESULT ContentManager::ReleasePackage(ContentPackage* package, std::string_view why) {
+  const bool transactional = package->transactional();
+  const auto package_path = package->package_path();
+  const auto what = Describe(package->GetPackageContentData());
+  delete package;  // unmounts; the guest's handles were released by DetachPackage
+  if (!transactional) {
+    return X_ERROR_SUCCESS;
+  }
+  auto result = content_txn::Commit(package_path);
+  if (!result.ok) {
+    REXKRNL_ERROR("[content] {} {}: commit failed, the previous version stays: {}", why, what, result.error);
+    return X_ERROR_ACCESS_DENIED;
+  }
+  REXKRNL_INFO("[content] {} {}: {} ({} files, {} bytes{})", why, what,
+               result.changed ? "committed" : "unchanged", result.files, result.bytes, ChangedList(result));
+  return X_ERROR_SUCCESS;
+}
