+
+namespace {
+// Command processor time accounting (--gpu_cp_stats). Written and logged by the command processor thread only.
+struct CpStats {
+  using Clock = std::chrono::steady_clock;
+  Clock::time_point window_start = Clock::now();
+  uint64_t exec_ns = 0, idle_ns = 0, wait_ns = 0, wait_sleep_ns = 0;
+  uint32_t batches = 0, waits = 0, wait_polls = 0, wait_sleeps = 0;
+  std::map<uint64_t, std::pair<uint32_t, uint64_t>> by_target;  // (poll address | info << 32) -> (waits, ns)
+
+  static uint64_t Ns(Clock::time_point a, Clock::time_point b) {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(b - a).count());
+  }
+  void MaybeLog() {
+    const auto now = Clock::now();
+    const double window_s = Ns(window_start, now) / 1e9;
+    if (window_s < 10.0) {
+      return;
+    }
+    std::string top;
+    std::vector<std::pair<uint64_t, std::pair<uint32_t, uint64_t>>> sorted(by_target.begin(), by_target.end());
+    std::sort(sorted.begin(), sorted.end(),
+              [](const auto& a, const auto& b) { return a.second.second > b.second.second; });
+    for (size_t i = 0; i < sorted.size() && i < 4; ++i) {
+      top += fmt::format(" [{} {:08X} info {:X}: {} waits {:.0f} ms]", (sorted[i].first >> 36) & 1 ? "mem" : "reg",
+                         uint32_t(sorted[i].first), uint32_t(sorted[i].first >> 32) & 0xFF,
+                         sorted[i].second.first, sorted[i].second.second / 1e6);
+    }
+    REXGPU_INFO("[cp-stats] {:.1f} s: executing {:.0f} ms in {} batches (waits inside: {:.0f} ms, {} WAIT_REG_MEM "
+                "with {} polls, {} sleeps = {:.0f} ms), idle for commands {:.0f} ms;{}",
+                window_s, exec_ns / 1e6, batches, wait_ns / 1e6, waits, wait_polls, wait_sleeps,
+                wait_sleep_ns / 1e6, idle_ns / 1e6, top);
+    *this = CpStats();
+  }
+};
+CpStats g_cp_stats;
+}  // namespace
 
