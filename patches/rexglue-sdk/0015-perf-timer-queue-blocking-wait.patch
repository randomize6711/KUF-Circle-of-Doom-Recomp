 namespace dp = disruptorplus;
 
+namespace {
+
+// KUF port (M12): disruptorplus's blocking_wait_strategy, with the timed wait it gets wrong (it passes the predicate
+// before the time to condition_variable::wait_until). Waiting blocks on a condition variable until a sequence is
+// published (publish signals under the same mutex, so no wake-up is lost) or the time is reached.
+class BlockingWaitStrategy {
+ public:
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[]) {
+    dp::sequence_t result;
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait(lock, [&] {
+      result = dp::minimum_sequence_after(sequence, count, sequences);
+      return dp::difference(result, sequence) >= 0;
+    });
+    return result;
+  }
+
+  template <typename Clock, typename Duration>
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[],
+                                      const std::chrono::time_point<Clock, Duration>& timeout_time) {
+    dp::sequence_t result;
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait_until(lock, timeout_time, [&] {
+      result = dp::minimum_sequence_after(sequence, count, sequences);
+      return dp::difference(result, sequence) >= 0;
+    });
+    return result;
+  }
+
+  void signal_all_when_blocking() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.notify_all();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::condition_variable cv_;
+};
+
+}  // namespace
