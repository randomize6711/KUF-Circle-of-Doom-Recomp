 namespace rex {
 namespace ui {
 namespace vulkan {
 
+namespace {
+
+// SDK patch 0017 (KUF port M13): with resizable BAR on a discrete GPU, upload pages live in device-local host-visible
+// memory, so the GPU's copies and reads of uploaded data (vertex data, constants, shared memory) do not cross PCIe
+// each frame. Integrated GPUs (the Steam Deck) and small BAR windows keep system memory.
+constexpr VkDeviceSize kMinUploadBarHeapSize = VkDeviceSize(1) << 30;
+
+uint32_t ChooseUploadMemoryType(const VulkanDevice* vulkan_device, uint32_t supported_types) {
+  if (REXCVAR_GET(vulkan_upload_device_local)) {
+    const VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+    VkPhysicalDeviceProperties properties;
+    ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &properties);
+    VkPhysicalDeviceMemoryProperties memory_properties;
+    ifn.vkGetPhysicalDeviceMemoryProperties(vulkan_device->physical_device(), &memory_properties);
+    const VulkanDevice::MemoryTypes& memory_types = vulkan_device->memory_types();
+    uint32_t candidates = supported_types & memory_types.device_local & memory_types.host_visible &
+                          memory_types.host_coherent & ~memory_types.host_cached;
+    if (properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) {
+      uint32_t memory_type;
+      while (rex::bit_scan_forward(candidates, &memory_type)) {
+        candidates &= ~(uint32_t(1) << memory_type);
+        if (memory_properties.memoryHeaps[memory_properties.memoryTypes[memory_type].heapIndex].size >=
+            kMinUploadBarHeapSize) {
+          return memory_type;
+        }
+      }
+    }
+  }
+  return util::ChooseHostMemoryType(vulkan_device->memory_types(), supported_types, false);
+}
+
+}  // namespace
