+void VulkanCommandProcessor::DiagDumpBuffer(VkBuffer source, VkDeviceSize offset, VkDeviceSize size,
+                                            const std::string& name) {
+  if (REXCVAR_GET(gpu_trace_dir).empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkBuffer buffer = VK_NULL_HANDLE;
+  VkDeviceMemory buffer_memory = VK_NULL_HANDLE;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, buffer, buffer_memory)) {
+    return;
+  }
+  PushBufferMemoryBarrier(source, offset, size,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_TRANSFER_READ_BIT);
+  SubmitBarriers(true);
+  VkBufferCopy region = {};
+  region.srcOffset = offset;
+  region.size = size;
+  deferred_command_buffer_.CmdVkCopyBuffer(source, buffer, 1, &region);
+  PushBufferMemoryBarrier(buffer, 0, size, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  if (AwaitAllQueueOperationsCompletion()) {
+    void* mapping = nullptr;
+    if (dfn.vkMapMemory(device, buffer_memory, 0, VK_WHOLE_SIZE, 0, &mapping) == VK_SUCCESS) {
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = buffer_memory;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+      std::string path = fmt::format("{}/{}", REXCVAR_GET(gpu_trace_dir), name);
+      if (FILE* f = std::fopen(path.c_str(), "wb")) {
+        std::fwrite(mapping, 1, size_t(size), f);
+        std::fclose(f);
+      }
+      dfn.vkUnmapMemory(device, buffer_memory);
+    }
+  }
+  BeginSubmission(true);
+  dfn.vkDestroyBuffer(device, buffer, nullptr);
+  dfn.vkFreeMemory(device, buffer_memory, nullptr);
+}
+
+void VulkanCommandProcessor::DiagTraceDraw(const VulkanShader* vs, const VulkanShader* ps) {
+  const RegisterFile& regs = *register_file_;
+  std::string line = fmt::format(
+      "[gputrace] swap {} draw {} after_resolve {} vs {:016X} ps {:016X} surface {:08X} color {:08X} {:08X} "
+      "{:08X} {:08X} depth {:08X} mask {:08X} modectl {:08X} sx {:08X} sy {:08X} wscissor {:08X} {:08X}",
+      g_diag_swap, g_diag_draw_index, g_diag_resolve_index, vs ? vs->ucode_data_hash() : 0,
+      ps ? ps->ucode_data_hash() : 0, regs[XE_GPU_REG_RB_SURFACE_INFO],
+      regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_RB_COLOR1_INFO],
+      regs[XE_GPU_REG_RB_COLOR2_INFO], regs[XE_GPU_REG_RB_COLOR3_INFO],
+      regs[XE_GPU_REG_RB_DEPTH_INFO], regs[XE_GPU_REG_RB_COLOR_MASK],
+      regs[XE_GPU_REG_RB_MODECONTROL], regs[XE_GPU_REG_PA_CL_VPORT_XSCALE],
+      regs[XE_GPU_REG_PA_CL_VPORT_YSCALE], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR]);
+  if (ps) {
+    for (const auto& binding : ps->texture_bindings()) {
+      uint32_t base = XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + binding.fetch_constant * 6;
+      line += fmt::format(" tf{}={:08X}:{:08X}:{:08X}:{:08X}:{:08X}:{:08X}", binding.fetch_constant,
+                          regs[base], regs[base + 1], regs[base + 2], regs[base + 3],
+                          regs[base + 4], regs[base + 5]);
+    }
+    line += fmt::format(" depthctl {:08X} stencil {:08X} blend0 {:08X} colorctl {:08X}",
+                        regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_RB_STENCILREFMASK],
+                        regs[XE_GPU_REG_RB_BLENDCONTROL0], regs[XE_GPU_REG_RB_COLORCONTROL]);
+    // The pixel shader's float constants it reads (c<n>=x,y,z,w).
+    const Shader::ConstantRegisterMap& map = ps->constant_register_map();
+    for (uint32_t i = 0; i < 256 && !map.float_dynamic_addressing; ++i) {
+      if (!(map.float_bitmap[i >> 6] & (uint64_t(1) << (i & 63)))) continue;
+      const float* c = reinterpret_cast<const float*>(&regs[XE_GPU_REG_SHADER_CONSTANT_256_X + (i << 2)]);
+      line += fmt::format(" c{}={:g},{:g},{:g},{:g}", i, c[0], c[1], c[2], c[3]);
+    }
+  }
+  REXGPU_INFO("{}", line);
+  ++g_diag_draw_index;
+}
+
+void VulkanCommandProcessor::DiagTraceResolve(uint32_t written_address, uint32_t written_length) {
+  const RegisterFile& regs = *register_file_;
+  uint32_t index = g_diag_resolve_index++;
+  bool scaled = texture_cache_->IsDrawResolutionScaled();
+  REXGPU_INFO(
+      "[gputrace] swap {} resolve {} before_draw {} written {:08X}+{:08X} scaled {} copy_control {:08X} "
+      "dest_info {:08X} dest_pitch {:08X} dest_base {:08X} surface {:08X} color {:08X} {:08X} "
+      "{:08X} {:08X} depth {:08X} window_offset {:08X} sc_tl {:08X} sc_br {:08X} "
+      "vtx {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}",
+      g_diag_swap, index, g_diag_draw_index, written_address, written_length, scaled,
+      regs[XE_GPU_REG_RB_COPY_CONTROL], regs[XE_GPU_REG_RB_COPY_DEST_INFO],
+      regs[XE_GPU_REG_RB_COPY_DEST_PITCH], regs[XE_GPU_REG_RB_COPY_DEST_BASE],
+      regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_RB_COLOR_INFO],
+      regs[XE_GPU_REG_RB_COLOR1_INFO], regs[XE_GPU_REG_RB_COLOR2_INFO],
+      regs[XE_GPU_REG_RB_COLOR3_INFO], regs[XE_GPU_REG_RB_DEPTH_INFO],
+      regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], regs[XE_GPU_REG_RB_COPY_SURFACE_SLICE],
+      regs[XE_GPU_REG_RB_COPY_FUNC], regs[XE_GPU_REG_RB_COPY_REF], regs[XE_GPU_REG_RB_COPY_MASK],
+      regs[XE_GPU_REG_RB_COLOR_CLEAR], regs[XE_GPU_REG_RB_COLOR_CLEAR_LO]);
+  if (!written_length || REXCVAR_GET(gpu_trace_dir).empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  uint64_t source_start = written_address, source_length = written_length;
+  VkBuffer source = shared_memory_->buffer();
+  if (scaled) {
+    if (!texture_cache_->GetScaledResolveRange(written_address, written_length, 0, source_start,
+                                               source_length)) {
+      return;
+    }
+    source = texture_cache_->scaled_resolve_buffer();
+    texture_cache_->UseScaledResolveBufferForRead();
+  } else {
+    shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  }
+  VkBuffer buffer = VK_NULL_HANDLE;
+  VkDeviceMemory buffer_memory = VK_NULL_HANDLE;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, source_length, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, buffer, buffer_memory)) {
+    return;
+  }
+  SubmitBarriers(true);
+  VkBufferCopy region = {};
+  region.srcOffset = source_start;
+  region.size = source_length;
+  deferred_command_buffer_.CmdVkCopyBuffer(source, buffer, 1, &region);
+  PushBufferMemoryBarrier(buffer, 0, source_length, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  if (AwaitAllQueueOperationsCompletion()) {
+    void* mapping = nullptr;
+    if (dfn.vkMapMemory(device, buffer_memory, 0, VK_WHOLE_SIZE, 0, &mapping) == VK_SUCCESS) {
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = buffer_memory;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+      std::string path = fmt::format("{}/resolve_s{}_{:03}_{:08X}.bin", REXCVAR_GET(gpu_trace_dir),
+                                     g_diag_swap, index, written_address);
+      if (FILE* f = std::fopen(path.c_str(), "wb")) {
+        std::fwrite(mapping, 1, size_t(source_length), f);
+        std::fclose(f);
+      }
+      dfn.vkUnmapMemory(device, buffer_memory);
+    }
+  }
+  BeginSubmission(true);
+  dfn.vkDestroyBuffer(device, buffer, nullptr);
+  dfn.vkFreeMemory(device, buffer_memory, nullptr);
+}
