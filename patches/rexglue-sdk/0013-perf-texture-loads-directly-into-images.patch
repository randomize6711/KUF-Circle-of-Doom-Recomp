+VkFormat VulkanTextureCache::GetDirectLoadViewFormat(const TextureKey& key, VkFormat host_format) const {
+  if (!REXCVAR_GET(vulkan_texture_load_direct_to_image) || direct_load_descriptor_set_layout_ == VK_NULL_HANDLE ||
+      !key.scaled_resolve || key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.GetDepthOrArraySize() != 1 || key.mip_max_level != 0) {
+    return VK_FORMAT_UNDEFINED;
+  }
+  // Only formats the device can use as storage images (checked at initialization); the others use the staging buffer.
+  const VkFormat view_format = DirectLoadViewFormatFor(host_format);
+  if (view_format == VK_FORMAT_UNDEFINED ||
+      std::find(direct_load_host_formats_.begin(), direct_load_host_formats_.end(), host_format) ==
+          direct_load_host_formats_.end()) {
+    return VK_FORMAT_UNDEFINED;
+  }
+  return view_format;
+}
+
+VkFormat VulkanTextureCache::DirectLoadViewFormatFor(VkFormat host_format) {
+  // Uncompressed formats whose bits the load shaders write as they are (same size class as the view).
+  switch (host_format) {
+    case VK_FORMAT_R16G16B16A16_UNORM:
+    case VK_FORMAT_R16G16B16A16_SNORM:
+    case VK_FORMAT_R16G16B16A16_UINT:
+    case VK_FORMAT_R16G16B16A16_SINT:
+    case VK_FORMAT_R16G16B16A16_SFLOAT:
+      return VK_FORMAT_R16G16B16A16_UINT;
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_R8G8B8A8_SNORM:
+    case VK_FORMAT_B8G8R8A8_UNORM:
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+    case VK_FORMAT_R16G16_UNORM:
+    case VK_FORMAT_R16G16_SNORM:
+    case VK_FORMAT_R16G16_SFLOAT:
+    case VK_FORMAT_R32_SFLOAT:
+    case VK_FORMAT_R32_UINT:
+      return VK_FORMAT_R32_UINT;
+    default:
+      return VK_FORMAT_UNDEFINED;
+  }
+}
