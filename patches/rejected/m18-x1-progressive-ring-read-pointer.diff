KUF port (M18): the command processor reported the primary ring's read pointer to the guest (the write-back the
guest's D3D waits on for ring space) only after executing everything up to the write pointer. The game's ring is
32 KB, so its render thread waited for space while a batch executed, and the two threads took turns. With
--gpu_cp_read_pointer_update_dwords=N the read pointer is written back whenever N more dwords have been read and
executed (real hardware advances it as it fetches); 0 keeps the old behaviour. Logs the ring's size and block size.
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -124,6 +124,12 @@
                     "pipelines are being prepared.")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_INT32(gpu_cp_read_pointer_update_dwords, 0, "GPU",
+                     "Report the ring buffer's read pointer to the guest (its write-back) whenever the command "
+                     "processor has read this many dwords of the primary ring, not only after executing everything "
+                     "up to the write pointer (0: only then). Real hardware advances the read pointer as it fetches, "
+                     "so the guest's wait for ring space ends while a long batch still executes");
+
 namespace rex::graphics {
 
 using namespace rex::graphics::xenos;
@@ -379,6 +385,8 @@
   // block_size = RB_BLKSZ, log2 of number of quadwords read between updates of
   //              the read pointer.
   read_ptr_update_freq_ = uint32_t(1) << block_size_log2 >> 2;
+  REXGPU_INFO("Ring buffer: {} bytes; read pointer write-back to {:08X}, block size log2 {}", primary_buffer_size_, ptr,
+              block_size_log2);
 }
 
 void CommandProcessor::UpdateWritePointer(uint32_t value) {
@@ -666,6 +674,7 @@
 
 void CommandProcessor::ReturnFromWait() {}
 
+
 uint32_t CommandProcessor::ExecutePrimaryBuffer(uint32_t read_index, uint32_t write_index) {
   SCOPE_profile_cpu_f("gpu");
 
@@ -673,6 +682,11 @@
   memory::RingBuffer reader(memory_->TranslatePhysical(primary_buffer_ptr_), primary_buffer_size_);
   reader.set_read_offset(read_index * sizeof(uint32_t));
   reader.set_write_offset(write_index * sizeof(uint32_t));
+  // Progressive read pointer (--gpu_cp_read_pointer_update_dwords): the packets already read are reported while the
+  // batch executes. A packet's dwords are not read again once it has executed, so the guest may reuse them.
+  const int32_t update_dwords = REXCVAR_GET(gpu_cp_read_pointer_update_dwords);
+  const uint32_t ring_mask = primary_buffer_size_ / sizeof(uint32_t) - 1;
+  uint32_t reported = read_index;
   do {
     if (!ExecutePacket(&reader)) {
       // This probably should be fatal - but we're going to continue anyways.
@@ -680,6 +694,13 @@
       assert_always();
       break;
     }
+    if (update_dwords > 0 && read_ptr_writeback_ptr_) {
+      const uint32_t now = uint32_t(reader.read_offset() / sizeof(uint32_t));
+      if (((now - reported) & ring_mask) >= uint32_t(update_dwords) && reader.read_count()) {
+        memory::store_and_swap<uint32_t>(memory_->TranslatePhysical(read_ptr_writeback_ptr_), now);
+        reported = now;
+      }
+    }
   } while (reader.read_count());
 
   OnPrimaryBufferEnd();
