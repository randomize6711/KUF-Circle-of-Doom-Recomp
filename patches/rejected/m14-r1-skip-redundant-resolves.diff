+bool RenderTargetCache::GetResolveSourceGenerations(
+    uint32_t base, uint32_t row_length, uint32_t rows, uint32_t pitch,
+    std::vector<std::pair<const RenderTarget*, uint64_t>>& sources_out) const {
+  sources_out.clear();
+  if (!row_length || !rows || row_length > pitch) {
+    return false;
+  }
+  auto add_extent = [&](uint32_t extent_start, uint32_t extent_end) {
+    auto it = ownership_ranges_.upper_bound(extent_start);
+    if (it == ownership_ranges_.cbegin()) {
+      return false;
+    }
+    --it;
+    uint32_t covered = extent_start;
+    for (; covered < extent_end; ++it) {
+      if (it == ownership_ranges_.cend() || it->first > covered || it->second.render_target.IsEmpty()) {
+        return false;
+      }
+      auto it_rt = render_targets_.find(it->second.render_target);
+      if (it_rt == render_targets_.cend() || !it_rt->second) {
+        return false;
+      }
+      const RenderTarget* rt = it_rt->second;
+      if (std::find_if(sources_out.cbegin(), sources_out.cend(),
+                       [rt](const auto& source) { return source.first == rt; }) == sources_out.cend()) {
+        sources_out.emplace_back(rt, rt->contents_generation());
+      }
+      covered = std::max(covered, it->second.end_tiles);
+    }
+    return true;
+  };
+  uint32_t area_end = base + (rows - 1) * pitch + row_length;
+  if (!add_extent(base, std::min(area_end, xenos::kEdramTileCount))) {
+    return false;
+  }
+  if (area_end > xenos::kEdramTileCount &&
+      !add_extent(0, std::min(area_end & (xenos::kEdramTileCount - 1), base))) {
+    return false;
+  }
+  return true;
+}
