+void VulkanRenderTargetCache::ResolveDestinationWatchCallback(
+    const std::unique_lock<std::recursive_mutex>& global_lock, void* context, uint32_t address_first,
+    uint32_t address_last, bool invalidated_by_gpu) {
+  static_cast<VulkanRenderTargetCache*>(context)->DropResolveRecords(address_first >> 12,
+                                                                     address_last >> 12);
+}
+
+void VulkanRenderTargetCache::DropResolveRecords(uint32_t page_first, uint32_t page_last) {
+  // With the global critical region held.
+  resolve_records_.erase(
+      std::remove_if(resolve_records_.begin(), resolve_records_.end(),
+                     [&](const ResolveRecord& record) {
+                       return record.page_first <= page_last && record.page_last >= page_first;
+                     }),
+      resolve_records_.end());
+}
+
+void VulkanRenderTargetCache::InvalidateResolveDestinations(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  if (!resolve_records_.empty()) {
+    DropResolveRecords(start >> 12, uint32_t((uint64_t(start) + length - 1) >> 12));
+  }
+}
