# Build trees, run sandboxes, analysis output (contains game-derived data: images, disassembly, logs)
/build/
/out/

# Recompiled C++ produced from the user's default.xex -- proprietary derivative, never commit.
# (generated/rexglue.cmake is SDK boilerplate and IS committed.)
/generated/*
!/generated/rexglue.cmake

