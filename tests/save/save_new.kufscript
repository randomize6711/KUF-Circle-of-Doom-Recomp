# Status screen (Tab): character, equipped weapons and abilities; C/Z (RT/LT) switch its tabs
@menu#2+10400 tap Tab
@menu#2+10480 capture status_saved
# Items tab: unequip the RB slot (White Potion x 5; RB is never used in the fight) so the saved equipment
# differs from a new character's: Down to RB, Change Item (A), then the list's first entry, Unequip (A).
# Menu confirmations use "press" (held 4 frames).
@menu#2+10500 tap C
@menu#2+10560 press Down
@menu#2+10620 capture equipment2_before_unequip
@menu#2+10640 press Return
@menu#2+10720 press Return
@menu#2+10800 capture equipment2_saved
# The same rows with the cursor back on row 1 (LB), as save_continue reads them: a highlighted row's
# text is brighter, so rows are compared with the same row selected on both sides.
@menu#2+10820 press Up
@menu#2+10880 capture equipment2_rows_saved
@menu#2+10920 tap C
@menu#2+11000 capture equipment3_saved
@menu#2+11020 tap Z
@menu#2+11050 tap Z
# Inventory (PageDown = RB); Escape twice returns to play
@menu#2+11120 tap PageDown
@menu#2+11200 capture inventory_saved
@menu#2+11220 tap Escape
@menu#2+11300 tap Escape

# Save: Escape opens the options menu (Sleep, Change Regions, View Quests, Controls, Settings, Quit)
@menu#2+11400 tap Escape
@menu#2+11500 tap Down
@menu#2+11530 tap Down
@menu#2+11560 tap Down
@menu#2+11590 tap Down
@menu#2+11620 tap Down
@menu#2+11680 capture quit_selected
@menu#2+11700 press Return
@menu#2+11790 capture save_question
@menu#2+11820 press Return
@menu#2+12170 capture title_after_save
