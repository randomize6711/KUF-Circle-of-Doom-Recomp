# Writes the build's version header (run at every build by the kuf_version target; rewritten only when it changes).
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -DBASE_VERSION=<x.y.z> -P cmake/kuf_version.cmake
# Version: BASE_VERSION, then "-dev.<commits since the base's tag or the root>+g<commit>" and ".dirty" for a modified
# tree (the SDK submodule's own state excluded). A release build sets KUFCOD_RELEASE_VERSION in the environment.
# Build time (UTC, to the minute): SOURCE_DATE_EPOCH when set (reproducible builds); else the commit's time for a
# clean tree (the same for every build of that commit), else (a modified tree) the time of this build.
find_package(Git QUIET)
set(_commit "unknown")
set(_count "0")
set(_dirty "")
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=10 HEAD
                    OUTPUT_VARIABLE _commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _r1)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-list --count HEAD
                    OUTPUT_VARIABLE _count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --ignore-submodules=all
                    OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT _r1 EQUAL 0)
        set(_commit "unknown")
    endif()
    if(_status)
        set(_dirty ".dirty")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" log -1 --format=%ct
                    OUTPUT_VARIABLE _commit_time OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(DEFINED ENV{SOURCE_DATE_EPOCH} AND NOT "$ENV{SOURCE_DATE_EPOCH}" STREQUAL "")
    string(TIMESTAMP _built "%Y-%m-%d %H:%M" UTC)  # CMake honours SOURCE_DATE_EPOCH here
elseif(_dirty STREQUAL "" AND _commit_time MATCHES "^[0-9]+$")
    set(_saved "$ENV{SOURCE_DATE_EPOCH}")
    set(ENV{SOURCE_DATE_EPOCH} "${_commit_time}")
    string(TIMESTAMP _built "%Y-%m-%d %H:%M" UTC)
    set(ENV{SOURCE_DATE_EPOCH} "${_saved}")
else()
    string(TIMESTAMP _built "%Y-%m-%d %H:%M" UTC)
endif()
if(DEFINED ENV{KUFCOD_RELEASE_VERSION} AND NOT "$ENV{KUFCOD_RELEASE_VERSION}" STREQUAL "")
    set(_version "$ENV{KUFCOD_RELEASE_VERSION}")
else()
    set(_version "${BASE_VERSION}-dev.${_count}+g${_commit}${_dirty}")
endif()
set(_text "// Generated by cmake/kuf_version.cmake at build time. Do not edit.
#pragma once
#define KUFCOD_VERSION \"${_version}\"
#define KUFCOD_BASE_VERSION \"${BASE_VERSION}\"
#define KUFCOD_GIT_COMMIT \"${_commit}${_dirty}\"
#define KUFCOD_BUILD_TIME_UTC \"${_built}\"
")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
else()
    set(_old "")
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUTPUT}" "${_text}")
endif()
