# Windows x64 build with llvm-mingw (M16, docs/WINDOWS.md): Clang, LLD and libc++ targeting MinGW-w64 with the
# Universal C Runtime (Windows 10 and 11). From this Linux machine with the pinned release that
# tools/toolchain/setup_llvm_mingw.sh unpacks; KUFCOD_LLVM_MINGW names another copy (on Windows: the same release's
# Windows build, which the Windows packages carry for the player's local build).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT KUFCOD_LLVM_MINGW)
    if(DEFINED ENV{KUFCOD_LLVM_MINGW})
        set(KUFCOD_LLVM_MINGW "$ENV{KUFCOD_LLVM_MINGW}")
    elseif(CMAKE_HOST_WIN32)  # a Windows host: the release's Windows build (tools/toolchain/setup_llvm_mingw.sh)
        set(KUFCOD_LLVM_MINGW "${CMAKE_CURRENT_LIST_DIR}/../build/toolchains/llvm-mingw-20261006-ucrt-x86_64")
    else()
        set(KUFCOD_LLVM_MINGW "${CMAKE_CURRENT_LIST_DIR}/../build/toolchains/llvm-mingw-20261006-ucrt-ubuntu-22.04-x86_64")
    endif()
endif()
get_filename_component(KUFCOD_LLVM_MINGW "${KUFCOD_LLVM_MINGW}" ABSOLUTE)
set(KUFCOD_LLVM_MINGW "${KUFCOD_LLVM_MINGW}" CACHE PATH "llvm-mingw root")
set(_triple x86_64-w64-mingw32)
if(CMAKE_HOST_WIN32)
    set(_exe ".exe")
else()
    set(_exe "")
endif()
if(NOT EXISTS "${KUFCOD_LLVM_MINGW}/bin/${_triple}-clang++${_exe}")
    message(FATAL_ERROR "llvm-mingw not found in ${KUFCOD_LLVM_MINGW}: run tools/toolchain/setup_llvm_mingw.sh "
                        "(it downloads the pinned release and checks its SHA-256), or set KUFCOD_LLVM_MINGW")
endif()
set(CMAKE_C_COMPILER "${KUFCOD_LLVM_MINGW}/bin/${_triple}-clang${_exe}")
set(CMAKE_CXX_COMPILER "${KUFCOD_LLVM_MINGW}/bin/${_triple}-clang++${_exe}")
set(CMAKE_RC_COMPILER "${KUFCOD_LLVM_MINGW}/bin/${_triple}-windres${_exe}")
set(CMAKE_AR "${KUFCOD_LLVM_MINGW}/bin/llvm-ar${_exe}" CACHE FILEPATH "")
set(CMAKE_RANLIB "${KUFCOD_LLVM_MINGW}/bin/llvm-ranlib${_exe}" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "${KUFCOD_LLVM_MINGW}/${_triple}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
